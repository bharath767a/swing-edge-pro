# ============================================================
#   SwingEdge Pro — Environment Configuration
#   Copy this file to .env and fill in your API keys
# ============================================================

# ─── FREE APIs (GET THESE NOW) ───────────────────────────────

# Finnhub — Free 60 req/min  |  https://finnhub.io/register
# Powers: news, insider trades, earnings calendar, analyst ratings, social sentiment
FINNHUB_API_KEY=

# Alpha Vantage — Free 25 req/day  |  https://www.alphavantage.co/support/#api-key
# Powers: fundamentals backup, earnings history
ALPHA_VANTAGE_KEY=

# NewsAPI — Free 100 req/day  |  https://newsapi.org/register
# Powers: global news, political signals, cross-linked intelligence
NEWS_API_KEY=

# FRED (Federal Reserve Economic Data) — Free unlimited  |  https://fred.stlouisfed.org/docs/api/api_key.html
# Powers: CPI, Fed funds rate, GDP, unemployment, yield curve
FRED_API_KEY=

# Reddit — Free  |  https://www.reddit.com/prefs/apps (create "script" type app)
# Powers: WSB sentiment, mention counts, retail sentiment
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SwingEdgePro/1.0

# ─── APP SETTINGS ────────────────────────────────────────────

APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./swingengine.db
LOG_LEVEL=INFO

# ─── PAID UPGRADES (Purchase Later for Better Accuracy) ─────────

# Polygon.io — $29/mo  |  https://polygon.io
# UNLOCKS: Real-time options chain, dark pool prints, short interest, tick data
# Impact: +20% accuracy on smart money signals
# POLYGON_IO_KEY=

# Unusual Whales — $50/mo  |  https://unusualwhales.com
# UNLOCKS: Congressional stock trades, dark pool sweeps, options flow
# Impact: +15% accuracy on insider/institutional intelligence
# UNUSUAL_WHALES_KEY=

# EODHD — $20/mo  |  https://eodhd.com
# UNLOCKS: Global fundamentals (Samsung, Toyota, TSMC), international insider data
# Impact: +25% accuracy on global cross-linking
# EODHD_KEY=

# Tiingo — $10/mo  |  https://www.tiingo.com
# UNLOCKS: Better point-in-time fundamentals, intraday data
# Impact: +10% accuracy on fundamentals
# TIINGO_KEY=

# Benzinga — $49/mo  |  https://www.benzinga.com/apis
# UNLOCKS: Premium news (2-3 min faster), analyst ratings feed, earnings transcripts
# Impact: +15% accuracy on news intelligence
# BENZINGA_KEY=

# OpenAI — Pay-per-use ~$10-20/mo  |  https://platform.openai.com
# UNLOCKS: GPT-4 powered news cross-linking, political signal interpretation
# Impact: +30% quality on AI explanations
# OPENAI_API_KEY=

# Twitter/X API — $100/mo Basic  |  https://developer.twitter.com
# UNLOCKS: Real-time Trump/executive tweets, CEO posts, market-moving social posts
# Impact: +20% accuracy on political signals
# TWITTER_BEARER_TOKEN=

# Nasdaq Data Link (Quandl) — $50/mo  |  https://data.nasdaq.com
# UNLOCKS: Institutional-grade data, 13F, short interest, SEC parsed data
# QUANDL_KEY=

# ─── v3 UPGRADE SETTINGS ──────────────────────────────────────

# OpenAI — for real LLM-driven multi-agent consensus (NEW in v3)
# Without this, the consensus engine falls back to rule-based (3 if-statements)
# UNLOCKS: GPT-4 powered technical/fundamental/macro agent debate
# Impact: Replaces fake "multi-agent" with real LLM reasoning
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# CORS — comma-separated list of allowed origins (P2 FIX)
# Default allows localhost dev. For production, set to your domain only.
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000,http://127.0.0.1:8000

# API Key Auth — comma-separated list of valid API keys (P2 FIX)
# Leave empty for dev mode (no auth). Set for production deployment.
# VALID_API_KEYS=key1,key2,key3
